## Create table of estimated Means and SD after censoring for each vaccine
# Negative log likelihood of normal distribution model with censoring
Likelihood <- function(p, censT, data) {-sum(log(dnorm(data[data > censT], p[1], p[2]))) - sum(log(pnorm(data[data <= censT], p[1], p[2])))}

