group_regimen <- function(df) {
  df <- df %>% 
    mutate(vacc = if_else(grepl("Pf", regimen, ignore.case = T) | grepl("MD", regimen, ignore.case = T) | grepl("SV", regimen, ignore.case = T) | grepl("SP", regimen, ignore.case = T) | grepl("JS", regimen, ignore.case = T) | grepl("AZ", regimen, ignore.case = T), "Yes", "No"),
           naive = if_else(!grepl("Conv", regimen, ignore.case = T), "Yes", "No"),
           hybrid = if_else(vacc == "Yes" & naive == "No", 
                            if_else(grepl("Conv", dose1, ignore.case = T), "Hybrid", "Breakthrough"),
                            "No"),
           group = case_when(dose1 == "ConvWT" & is.na(dose2) ~ "Convalescent",
                             grepl("Pf", dose1, ignore.case = T) & grepl("Pf", dose2, ignore.case = T) & grepl("MD", dose3, ignore.case = T) ~ "Pf_Pf_MD",
                             grepl("SV", dose1, ignore.case = T) & grepl("SV", dose2, ignore.case = T) & grepl("Pf", dose3, ignore.case = T) ~ "SV_SV_Pf",
                             grepl("Pf", dose1, ignore.case = T) + grepl("Pf", dose2, ignore.case = T) + grepl("Pf", dose3, ignore.case = T) + grepl("Pf", dose4, ignore.case = T) == 1 ~ "Pfizer1",
                             grepl("Pf", dose1, ignore.case = T) + grepl("Pf", dose2, ignore.case = T) + grepl("Pf", dose3, ignore.case = T) + grepl("Pf", dose4, ignore.case = T) == 2 ~ "Pfizer2",
                             grepl("Pf", dose1, ignore.case = T) + grepl("Pf", dose2, ignore.case = T) + grepl("Pf", dose3, ignore.case = T) + grepl("Pf", dose4, ignore.case = T) == 3 ~ "Pfizer3",
                             grepl("MD", dose1, ignore.case = T) + grepl("MD", dose2, ignore.case = T) + grepl("MD", dose3, ignore.case = T) + grepl("MD", dose4, ignore.case = T) == 1 ~ "Moderna1",
                             grepl("MD", dose1, ignore.case = T) + grepl("MD", dose2, ignore.case = T) + grepl("MD", dose3, ignore.case = T) + grepl("MD", dose4, ignore.case = T) == 2 ~ "Moderna2",
                             grepl("MD", dose1, ignore.case = T) + grepl("MD", dose2, ignore.case = T) + grepl("MD", dose3, ignore.case = T) + grepl("MD", dose4, ignore.case = T) == 3 ~ "Moderna3",
                             grepl("mRNA", dose1, ignore.case = T) + grepl("mRNA", dose2, ignore.case = T) + grepl("mRNA", dose3, ignore.case = T) + grepl("mRNA", dose4, ignore.case = T) == 1 ~ "mRNA1",
                             grepl("mRNA", dose1, ignore.case = T) + grepl("mRNA", dose2, ignore.case = T) + grepl("mRNA", dose3, ignore.case = T) + grepl("mRNA", dose4, ignore.case = T) == 2 ~ "mRNA2",
                             grepl("mRNA", dose1, ignore.case = T) + grepl("mRNA", dose2, ignore.case = T) + grepl("mRNA", dose3, ignore.case = T) + grepl("mRNA", dose4, ignore.case = T) == 3 ~ "mRNA3",
                             grepl("SV", dose1, ignore.case = T) + grepl("SV", dose2, ignore.case = T) + grepl("SV", dose3, ignore.case = T) + grepl("SV", dose4, ignore.case = T) == 1 ~ "Sinovac1",
                             grepl("SV", dose1, ignore.case = T) + grepl("SV", dose2, ignore.case = T) + grepl("SV", dose3, ignore.case = T) + grepl("SV", dose4, ignore.case = T) == 2 ~ "Sinovac2",
                             grepl("SV", dose1, ignore.case = T) + grepl("SV", dose2, ignore.case = T) + grepl("SV", dose3, ignore.case = T) + grepl("SV", dose4, ignore.case = T) == 3 ~ "Sinovac3",
                             grepl("AZ", dose1, ignore.case = T) + grepl("AZ", dose2, ignore.case = T) + grepl("AZ", dose3, ignore.case = T) + grepl("AZ", dose4, ignore.case = T) == 1 ~ "AstraZeneca1",
                             grepl("AZ", dose1, ignore.case = T) + grepl("AZ", dose2, ignore.case = T) + grepl("AZ", dose3, ignore.case = T) + grepl("AZ", dose4, ignore.case = T) == 2 ~ "AstraZeneca2",
                             grepl("JS", dose1, ignore.case = T) + grepl("JS", dose2, ignore.case = T) + grepl("JS", dose3, ignore.case = T) + grepl("JS", dose4, ignore.case = T) == 1 ~ "Johnson & Johnson",
                             grepl("SP", dose1, ignore.case = T) + grepl("SP", dose2, ignore.case = T) + grepl("SP", dose3, ignore.case = T) + grepl("SP", dose4, ignore.case = T) == 1 ~ "Sinopharm1",
                             grepl("SP", dose1, ignore.case = T) + grepl("SP", dose2, ignore.case = T) + grepl("SP", dose3, ignore.case = T) + grepl("SP", dose4, ignore.case = T) == 2 ~ "Sinopharm2",
                             TRUE ~ regimen)
    )
  return(df)
}

