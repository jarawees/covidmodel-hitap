## Calculate Mean Ratio (Vaccine to Conv Neut) for each vaccine combination
calc_mean_ratio <- function(MeanSD_ind) {
  MeanSD_ind <- MeanSD_ind %>%
    group_by(study_id) %>% 
    rename(Num = Num_ppl) %>% 
    mutate(across(c(EstimatedMean, SD, Num), ~ .[(group == "Convalescent" & variant == "WT") | (group == "Convalescent" & variant == "D614G") | (group == "Convalescent" & variant == "WA1")| (group == "Convalescent" & variant == "B.1")], .names = "{col}Conv"),
           MeanRatio = EstimatedMean - EstimatedMeanConv, # Ratio Vaccine to Conv Neut
           SEM = sqrt((SD^2/Num) + (SDConv^2/NumConv))) # SEM of the Ratio Vaccine to Conv Neut
  return(MeanSD_ind)
}

